import matplotlib.pyplot as plt
from datasets import load_dataset

# Tải lại dataset (do đã có cache nên sẽ load rất nhanh)
dataset = load_dataset("taesiri/imagenet-hard", split="validation")

# ID của các ảnh trong Cụm 1 mà thuật toán của bạn vừa gom lại
# Bạn có thể thay đổi các ID này dựa trên log bạn vừa in ra
cluster_image_ids = [7690, 7704, 6716, 8252, 6719]

fig, axes = plt.subplots(1, len(cluster_image_ids), figsize=(12, 4))

for i, img_id in enumerate(cluster_image_ids):
    img = dataset[img_id]['image']
    label = dataset[img_id]['label']
    
    axes[i].imshow(img)
    axes[i].set_title(f"ID: {img_id} | Nhãn gốc: {label}")
    axes[i].axis('off')

plt.show()